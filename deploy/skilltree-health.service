[Unit]
Description=SkillTree local business storage health check
After=skilltree.service skilltree-evaluation.service nginx.service

[Service]
Type=oneshot
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 10 http://127.0.0.1:8080/healthz
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 10 http://127.0.0.1:8765/healthz
StandardOutput=journal
StandardError=journal
