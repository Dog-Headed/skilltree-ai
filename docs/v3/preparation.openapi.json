{
  "openapi": "3.1.0",
  "info": {
    "title": "SkillTree V3 preparation only",
    "version": "0.1.0"
  },
  "paths": {
    "/projects": {
      "post": {
        "summary": "Create",
        "operationId": "create_projects_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}": {
      "get": {
        "summary": "Read",
        "operationId": "read_projects__project_id__get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/resume": {
      "post": {
        "summary": "Resume",
        "operationId": "resume_projects__project_id__resume_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreparationInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/retry": {
      "post": {
        "summary": "Retry",
        "operationId": "retry_projects__project_id__retry_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetryInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/sources": {
      "post": {
        "summary": "Upload",
        "operationId": "upload_projects__project_id__sources_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceUpload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Sources",
        "operationId": "sources_projects__project_id__sources_get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "summary": "Capabilities",
        "operationId": "capabilities_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDraft": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "profile": {
            "$ref": "#/components/schemas/LearningProfile"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "profile"
        ],
        "title": "CreateDraft"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LanguagePreference": {
        "properties": {
          "teaching": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Teaching",
            "default": "zh-CN"
          },
          "answering": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Answering",
            "default": "zh-CN"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LanguagePreference"
      },
      "LearningProfile": {
        "properties": {
          "subject_label": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Subject Label"
          },
          "topic": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Topic"
          },
          "goal": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Goal"
          },
          "bounded_goal": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Bounded Goal"
          },
          "prior_knowledge": {
            "$ref": "#/components/schemas/PriorKnowledge"
          },
          "target_level": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Target Level",
            "default": "入门"
          },
          "language": {
            "$ref": "#/components/schemas/LanguagePreference"
          },
          "time_budget_minutes": {
            "type": "integer",
            "maximum": 10080.0,
            "exclusiveMinimum": 0.0,
            "title": "Time Budget Minutes",
            "default": 120
          },
          "session_minutes": {
            "type": "integer",
            "maximum": 480.0,
            "exclusiveMinimum": 0.0,
            "title": "Session Minutes",
            "default": 30
          },
          "scope_in": {
            "items": {
              "type": "string",
              "maxLength": 4000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Scope In"
          },
          "scope_out": {
            "items": {
              "type": "string",
              "maxLength": 4000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Scope Out"
          },
          "learning_mode": {
            "type": "string",
            "enum": [
              "formal",
              "exploration"
            ],
            "title": "Learning Mode",
            "default": "formal"
          },
          "requested_capabilities": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Requested Capabilities"
          },
          "profile_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Profile Version",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject_label",
          "topic",
          "goal"
        ],
        "title": "LearningProfile"
      },
      "PreparationInput": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "pending_input_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Pending Input Id"
          },
          "draft_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Draft Revision"
          },
          "action": {
            "type": "string",
            "enum": [
              "confirm_profile",
              "update_profile",
              "adjust_scope",
              "replan",
              "adjust_plan",
              "confirm_plan",
              "choose_exploration",
              "rest"
            ],
            "title": "Action"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LearningProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "pending_input_id",
          "draft_revision",
          "action"
        ],
        "title": "PreparationInput"
      },
      "PriorAssessmentEvidence": {
        "properties": {
          "project_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Project Id"
          },
          "node_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Node Id"
          },
          "assessment_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Assessment Id"
          },
          "objective_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Objective Id"
          },
          "summary": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project_id",
          "node_id",
          "assessment_id",
          "objective_id",
          "summary"
        ],
        "title": "PriorAssessmentEvidence"
      },
      "PriorKnowledge": {
        "properties": {
          "self_reported": {
            "items": {
              "type": "string",
              "maxLength": 4000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Self Reported"
          },
          "assessed_evidence": {
            "items": {
              "$ref": "#/components/schemas/PriorAssessmentEvidence"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Assessed Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PriorKnowledge"
      },
      "RetryInput": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "retry_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Retry Token"
          },
          "action": {
            "type": "string",
            "enum": [
              "retry",
              "continue_with_new_budget"
            ],
            "title": "Action",
            "default": "retry"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "retry_token"
        ],
        "title": "RetryInput"
      },
      "SourceUpload": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Title"
          },
          "source_description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Source Description"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "teaching",
              "assessment_private"
            ],
            "title": "Visibility",
            "default": "teaching"
          },
          "content": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 131072
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "data_base64": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 174764
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "title",
          "source_description"
        ],
        "title": "SourceUpload"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
